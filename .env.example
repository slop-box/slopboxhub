# Copy to .env on the server, next to docker-compose.yml. Never commit .env.

# The domain Cloudflare Tunnel serves, without https:// (games live at <id>.<domain>)
SLOPBOX_DOMAIN=example.com

# Host port Caddy listens on. Point the Cloudflare Tunnel at http://<unraid-ip>:<this port>.
SLOPBOX_HTTP_PORT=8480

# Per-game settings
QUICKPIC_ADMIN_PASSWORD=

# Party gate (PLAN.md Step 8)
SLOPBOX_ADMIN_PASSWORD=
SLOPBOX_GATE_SECRET=

# Updates (PLAN.md Step 11). Generate each with: openssl rand -hex 32
SLOPBOX_DEPLOY_TOKEN=
WATCHTOWER_API_TOKEN=
