# Copy to .env on the server, next to docker-compose.yml. Never commit .env.

# The domain Cloudflare Tunnel serves, without https:// (games live at <id>.<domain>)
SLOPBOX_DOMAIN=example.com

# Token for Slop Box's Cloudflare Tunnel (Zero Trust → Networks → Tunnels → the tunnel → Docker install command)
CLOUDFLARE_TUNNEL_TOKEN=

# Host port Caddy listens on, for testing from the home network. The tunnel itself uses caddy:80.
SLOPBOX_HTTP_PORT=8480

# Per-game settings
QUICKPIC_ADMIN_PASSWORD=

# Party gate (PLAN.md Step 8). The admin password opens every game; without it games stay closed.
SLOPBOX_ADMIN_PASSWORD=
# Signs the pass and login cookies. Generate with: openssl rand -hex 32
SLOPBOX_GATE_SECRET=
# Optional: how long a login opens the games, and how long devices already playing get afterwards
# GATE_OPEN_HOURS=4
# GATE_GRACE_MINUTES=60

# Updates (PLAN.md Step 11). Generate each with: openssl rand -hex 32
SLOPBOX_DEPLOY_TOKEN=
WATCHTOWER_API_TOKEN=
