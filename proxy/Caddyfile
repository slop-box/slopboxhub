# Cloudflare Tunnel sends <domain> and *.<domain> here over plain HTTP.
# Cloudflare handles HTTPS, so Caddy never requests certificates.
# SLOPBOX_DOMAIN comes from .env (e.g. example.com, no scheme).

{
	auto_https off
}

# Party gate (PLAN.md Step 8). Every game block starts with `import gate`: Caddy asks the hub
# before each request, and the hub lets it through, sends it to /pass, or to the closed page.
# /healthz skips the gate, so devs can check which version is live even while games are closed.
# It only says the game is up (and its commit), so nothing playable leaks out. Caddy's path match
# ignores case and tidies the path (//healthz, /x/../healthz), so anything that matched is rewritten
# to exactly /healthz first. Otherwise a game could read //healthz as its home page.
(gate) {
	@health path /healthz
	rewrite @health /healthz
	@gated not path /healthz
	forward_auth @gated hub:8080 {
		uri /check
	}
}

# Hub: landing page, party gate, and /deploy for devs' "Deploy now" runs (PLAN.md Step 11).
http://{$SLOPBOX_DOMAIN} {
	# Watchtower's update-lock hook asks the hub over the Docker network, never through here.
	respond /update-allowed* 404
	reverse_proxy hub:8080
}

# One block per game: http://<id>.{$SLOPBOX_DOMAIN} -> <id>:<port>
http://quickpic.{$SLOPBOX_DOMAIN} {
	import gate
	reverse_proxy quickpic:3000
}

http://debatebros.{$SLOPBOX_DOMAIN} {
	import gate
	reverse_proxy debatebros:3001
}

http://bank.{$SLOPBOX_DOMAIN} {
	import gate
	reverse_proxy bank:3000
}

# Anything else under the domain (typos, removed games) goes to the hub.
http:// {
	redir https://{$SLOPBOX_DOMAIN} 302
}
