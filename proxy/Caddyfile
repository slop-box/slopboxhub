# Cloudflare Tunnel sends <domain> and *.<domain> here over plain HTTP.
# Cloudflare handles HTTPS, so Caddy never requests certificates.
# SLOPBOX_DOMAIN comes from .env (e.g. example.com, no scheme).

{
	auto_https off
}

# Party gate (PLAN.md Step 8). Every game block starts with `import gate`: Caddy asks the hub
# before each request, and the hub lets it through, sends it to /pass, or to the closed page.
(gate) {
	forward_auth hub:8080 {
		uri /check
	}
}

# Hub: landing page (and later the party gate and the deploy route).
http://{$SLOPBOX_DOMAIN} {
	reverse_proxy hub:8080
}

# One block per game: http://<id>.{$SLOPBOX_DOMAIN} -> <id>:<port>
http://quickpic.{$SLOPBOX_DOMAIN} {
	import gate
	reverse_proxy quickpic:3000
}

# Anything else under the domain (typos, removed games) goes to the hub.
http:// {
	redir https://{$SLOPBOX_DOMAIN} 302
}
